TOKEN=ADD_YOUR_TOKEN_HERE
CLIENTID=ADD_YOUR_BOT_ID_HERE
VOTEDESK_ENABLED=false
# Each server chooses its own scheduled alert channel at runtime with
# the /proposals channel set (admins only). No channel means no posts.
# Optional overrides; defaults target the public ZecHub DAO in src/config/voteDesk.json.
# VOTEDESK_DAO_ADDRESS=
# VOTEDESK_DAO_URL=
# VOTEDESK_LCD_URL=https://juno-api.polkachu.com
# VOTEDESK_POLL_INTERVAL_SECONDS=300
# VOTEDESK_BLOCK_TIME_SECONDS=6